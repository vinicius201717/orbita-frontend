{
  "name": "orbita-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript docs/openapi.json -o src/types/openapi.generated.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write src tests docs *.md *.json"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.104.1",
    "react-hook-form": "7.89.0",
    "@hookform/resolvers": "5.9.1",
    "zod": "4.6.5",
    "socket.io-client": "^4.8.1",
    "ioredis": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.0",
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^27.0.0",
    "@playwright/test": "1.63.0",
    "dotenv": "^17.2.0"
  },
  "type": "module"
}
